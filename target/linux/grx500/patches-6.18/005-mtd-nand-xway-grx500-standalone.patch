From: Blue Cave OpenWrt Bringup
Subject: [PATCH] mtd: rawnand: xway: standalone GRX500 support without SOC_XWAY

--- a/drivers/mtd/nand/raw/Kconfig
+++ b/drivers/mtd/nand/raw/Kconfig
@@ -285,7 +285,7 @@
 
 config MTD_NAND_XWAY
 	bool "Lantiq XWAY NAND controller"
-	depends on LANTIQ && SOC_TYPE_XWAY
+	depends on (LANTIQ && SOC_TYPE_XWAY) || MIPS_GENERIC
 	help
 	  Enables support for NAND Flash chips on Lantiq XWAY SoCs. NAND is attached
 	  to the External Bus Unit (EBU).
--- a/drivers/mtd/nand/raw/xway_nand.c
+++ b/drivers/mtd/nand/raw/xway_nand.c
@@ -1,18 +1,19 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- *
- *  Copyright © 2012 John Crispin <john@phrozen.org>
- *  Copyright © 2016 Hauke Mehrtens <hauke@hauke-m.de>
+ *  Copyright (C) 2012 John Crispin <john@phrozen.org>
+ *  Copyright (C) 2016 Hauke Mehrtens <hauke@hauke-m.de>
+ *  Adapted for standalone MIPS_GENERIC (GRX350/GRX500) support.
  */
 
+#include <linux/io.h>
 #include <linux/mtd/rawnand.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/spinlock.h>
 
-#include <lantiq_soc.h>
-
-/* nand registers */
+/* EBU nand registers */
 #define EBU_ADDSEL1		0x24
+#define EBU_BUSCON1		0x64
 #define EBU_NAND_CON		0xB0
 #define EBU_NAND_WAIT		0xB4
 #define  NAND_WAIT_RD		BIT(0) /* NAND flash status output */
@@ -20,29 +21,19 @@
 #define EBU_NAND_ECC0		0xB8
 #define EBU_NAND_ECC_AC		0xBC
 
-/*
- * nand commands
- * The pins of the NAND chip are selected based on the address bits of the
- * "register" read and write. There are no special registers, but an
- * address range and the lower address bits are used to activate the
- * correct line. For example when the bit (1 << 2) is set in the address
- * the ALE pin will be activated.
- */
-#define NAND_CMD_ALE		BIT(2) /* address latch enable */
-#define NAND_CMD_CLE		BIT(3) /* command latch enable */
-#define NAND_CMD_CS		BIT(4) /* chip select */
-#define NAND_CMD_SE		BIT(5) /* spare area access latch */
-#define NAND_CMD_WP		BIT(6) /* write protect */
+#define NAND_CMD_ALE		BIT(2)
+#define NAND_CMD_CLE		BIT(3)
+#define NAND_CMD_CS		BIT(4)
+#define NAND_CMD_SE		BIT(5)
+#define NAND_CMD_WP		BIT(6)
 #define NAND_WRITE_CMD		(NAND_CMD_CS | NAND_CMD_CLE)
 #define NAND_WRITE_ADDR		(NAND_CMD_CS | NAND_CMD_ALE)
 #define NAND_WRITE_DATA		(NAND_CMD_CS)
 #define NAND_READ_DATA		(NAND_CMD_CS)
 
-/* we need to tel the ebu which addr we mapped the nand to */
-#define ADDSEL1_MASK(x)		(x << 4)
+#define ADDSEL1_MASK(x)		((x) << 4)
 #define ADDSEL1_REGEN		1
 
-/* we need to tell the EBU that we have nand attached and set it up properly */
 #define BUSCON1_SETUP		(1 << 22)
 #define BUSCON1_BCGEN_RES	(0x3 << 12)
 #define BUSCON1_WAITWRC2	(2 << 8)
@@ -64,10 +55,31 @@
 struct xway_nand_data {
 	struct nand_controller	controller;
 	struct nand_chip	chip;
+	spinlock_t		ebu_lock;
 	unsigned long		csflags;
 	void __iomem		*nandaddr;
+	void __iomem		*ebubase;
 };
 
+static inline u32 xway_ebu_r32(struct xway_nand_data *data, u32 reg)
+{
+	return readl(data->ebubase + reg);
+}
+
+static inline void xway_ebu_w32(struct xway_nand_data *data, u32 val, u32 reg)
+{
+	writel(val, data->ebubase + reg);
+}
+
+static inline void xway_ebu_w32_mask(struct xway_nand_data *data,
+				     u32 clr, u32 set, u32 reg)
+{
+	u32 val = xway_ebu_r32(data, reg);
+
+	val = (val & ~clr) | set;
+	xway_ebu_w32(data, val, reg);
+}
+
 static u8 xway_readb(struct mtd_info *mtd, int op)
 {
 	struct nand_chip *chip = mtd_to_nand(mtd);
@@ -90,14 +102,12 @@
 
 	switch (select) {
 	case -1:
-		ltq_ebu_w32_mask(NAND_CON_CE, 0, EBU_NAND_CON);
-		ltq_ebu_w32_mask(NAND_CON_NANDM, 0, EBU_NAND_CON);
-		spin_unlock_irqrestore(&ebu_lock, data->csflags);
+		xway_ebu_w32_mask(data, NAND_CON_CE, 0, EBU_NAND_CON);
+		xway_ebu_w32_mask(data, NAND_CON_NANDM, 0, EBU_NAND_CON);
 		break;
 	case 0:
-		spin_lock_irqsave(&ebu_lock, data->csflags);
-		ltq_ebu_w32_mask(0, NAND_CON_NANDM, EBU_NAND_CON);
-		ltq_ebu_w32_mask(0, NAND_CON_CE, EBU_NAND_CON);
+		xway_ebu_w32_mask(data, 0, NAND_CON_NANDM, EBU_NAND_CON);
+		xway_ebu_w32_mask(data, 0, NAND_CON_CE, EBU_NAND_CON);
 		break;
 	default:
 		BUG();
@@ -107,6 +117,9 @@
 static void xway_cmd_ctrl(struct nand_chip *chip, int cmd, unsigned int ctrl)
 {
 	struct mtd_info *mtd = nand_to_mtd(chip);
+	struct xway_nand_data *data = nand_get_controller_data(chip);
+
+	int timeout = 100000;
 
 	if (cmd == NAND_CMD_NONE)
 		return;
@@ -116,13 +129,15 @@
 	else if (ctrl & NAND_ALE)
 		xway_writeb(mtd, NAND_WRITE_ADDR, cmd);
 
-	while ((ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_WR_C) == 0)
-		;
+	while ((xway_ebu_r32(data, EBU_NAND_WAIT) & NAND_WAIT_WR_C) == 0 && --timeout > 0)
+		cpu_relax();
 }
 
 static int xway_dev_ready(struct nand_chip *chip)
 {
-	return ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_RD;
+	struct xway_nand_data *data = nand_get_controller_data(chip);
+
+	return xway_ebu_r32(data, EBU_NAND_WAIT) & NAND_WAIT_RD;
 }
 
 static unsigned char xway_read_byte(struct nand_chip *chip)
@@ -159,30 +174,35 @@
 	.attach_chip = xway_attach_chip,
 };
 
-/*
- * Probe for the NAND device.
- */
 static int xway_nand_probe(struct platform_device *pdev)
 {
 	struct xway_nand_data *data;
+	struct resource *nand_res;
 	struct mtd_info *mtd;
 	int err;
-	u32 cs;
+	u32 cs = 0;
 	u32 cs_flag = 0;
 
-	/* Allocate memory for the device structure (and zero it) */
 	data = devm_kzalloc(&pdev->dev, sizeof(struct xway_nand_data),
 			    GFP_KERNEL);
 	if (!data)
 		return -ENOMEM;
 
-	data->nandaddr = devm_platform_ioremap_resource(pdev, 0);
+	spin_lock_init(&data->ebu_lock);
+
+	data->nandaddr = devm_platform_get_and_ioremap_resource(pdev, 0, &nand_res);
 	if (IS_ERR(data->nandaddr))
 		return PTR_ERR(data->nandaddr);
 
+	data->ebubase = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(data->ebubase))
+		return PTR_ERR(data->ebubase);
+
 	nand_set_flash_node(&data->chip, pdev->dev.of_node);
 	mtd = nand_to_mtd(&data->chip);
 	mtd->dev.parent = &pdev->dev;
+	if (!mtd->name)
+		mtd->name = "17c00000.nand-parts";
 
 	data->chip.legacy.cmd_ctrl = xway_cmd_ctrl;
 	data->chip.legacy.dev_ready = xway_dev_ready;
@@ -199,34 +219,29 @@
 	platform_set_drvdata(pdev, data);
 	nand_set_controller_data(&data->chip, data);
 
-	/* load our CS from the DT. Either we find a valid 1 or default to 0 */
 	err = of_property_read_u32(pdev->dev.of_node, "lantiq,cs", &cs);
 	if (!err && cs == 1)
 		cs_flag = NAND_CON_IN_CS1 | NAND_CON_OUT_CS1;
 
-	/* setup the EBU to run in NAND mode on our base addr */
-	ltq_ebu_w32(CPHYSADDR(data->nandaddr)
-		    | ADDSEL1_MASK(3) | ADDSEL1_REGEN, EBU_ADDSEL1);
-
-	ltq_ebu_w32(BUSCON1_SETUP | BUSCON1_BCGEN_RES | BUSCON1_WAITWRC2
-		    | BUSCON1_WAITRDC2 | BUSCON1_HOLDC1 | BUSCON1_RECOVC1
-		    | BUSCON1_CMULT4, LTQ_EBU_BUSCON1);
-
-	ltq_ebu_w32(NAND_CON_NANDM | NAND_CON_CSMUX | NAND_CON_CS_P
-		    | NAND_CON_SE_P | NAND_CON_WP_P | NAND_CON_PRE_P
-		    | cs_flag, EBU_NAND_CON);
-
-	/*
-	 * This driver assumes that the default ECC engine should be TYPE_SOFT.
-	 * Set ->engine_type before registering the NAND devices in order to
-	 * provide a driver specific default value.
-	 */
+	dev_info(&pdev->dev, "xway_nand: U-Boot EBU ADDSEL1=0x%08x BUSCON1=0x%08x NAND_CON=0x%08x WAIT=0x%08x\n",
+		 xway_ebu_r32(data, EBU_ADDSEL1),
+		 xway_ebu_r32(data, EBU_BUSCON1),
+		 xway_ebu_r32(data, EBU_NAND_CON),
+		 xway_ebu_r32(data, EBU_NAND_WAIT));
+
+	/* Keep U-Boot EBU ADDSEL1/BUSCON1 timings; only ensure NAND_CON is configured */
+	xway_ebu_w32(data, NAND_CON_NANDM | NAND_CON_CSMUX | NAND_CON_CS_P
+		     | NAND_CON_SE_P | NAND_CON_WP_P | NAND_CON_PRE_P
+		     | cs_flag, EBU_NAND_CON);
+
 	data->chip.ecc.engine_type = NAND_ECC_ENGINE_TYPE_SOFT;
 
-	/* Scan to find existence of the device */
+	dev_info(&pdev->dev, "xway_nand: starting nand_scan...\n");
 	err = nand_scan(&data->chip, 1);
-	if (err)
+	if (err) {
+		dev_err(&pdev->dev, "xway_nand: nand_scan failed (%d)\n", err);
 		return err;
+	}
 
 	err = mtd_device_register(mtd, NULL, 0);
 	if (err)
@@ -235,9 +250,6 @@
 	return err;
 }
 
-/*
- * Remove a NAND device.
- */
 static void xway_nand_remove(struct platform_device *pdev)
 {
 	struct xway_nand_data *data = platform_get_drvdata(pdev);
