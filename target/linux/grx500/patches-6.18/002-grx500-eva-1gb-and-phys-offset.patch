 #ifndef __ASM_MACH_GENERIC_KERNEL_ENTRY_H
 #define __ASM_MACH_GENERIC_KERNEL_ENTRY_H
 
-/* Intentionally empty macro, used in head.S. Override in
- * arch/mips/mach-xxx/kernel-entry-init.h when necessary.
- */
-	.macro	kernel_entry_setup
+#ifdef CONFIG_EVA
+#include <asm/regdef.h>
+#include <asm/mipsregs.h>
+
+#ifdef __ASSEMBLY__
+
+	.macro platform_eva_init
+	.set push
+	.set reorder
+	mfc0 t1, CP0_CONFIG
+	andi t1, t1, 7
+	/* SegCtl0: mapped c0000000; uncached e0000000 -> a0000000. */
+	li t0, 0x00280a0a
+	ins t0, t1, 16, 3
+	mtc0 t0, CP0_SEGCTL0
+	/* SegCtl1: 80000000 -> 40000000; a0000000 -> 20000000. */
+	li t0, 0x0408020a
+	ins t0, t1, 16, 3
+	mtc0 t0, CP0_SEGCTL1
+	/* SegCtl2: mapped low 1GB; 40000000 -> 00000000 in kernel (0x60000000 -> 0x20000000). */
+	li t0, 0x00380048
+	ins t0, t1, 0, 3
+	mtc0 t0, CP0_SEGCTL2
+	jal mips_ihb
+	mfc0 t0, $16, 5
+	li t2, 0x40000000
+	or t0, t0, t2
+	mtc0 t0, $16, 5
+	sync
+	jal mips_ihb
+	.set pop
 	.endm
 
-/*
- * Do SMP slave processor setup necessary before we can safely execute C code.
- */
-	.macro	smp_slave_setup
+	.macro kernel_entry_setup
+	sync
+	ehb
+	platform_eva_init
 	.endm
 
+	.macro smp_slave_setup
+	sync
+	ehb
+	platform_eva_init
+	.endm
+
+#endif /* __ASSEMBLY__ */
+#else
+	.macro kernel_entry_setup
+	.endm
+
+	.macro smp_slave_setup
+	.endm
+#endif
 
 #endif /* __ASM_MACH_GENERIC_KERNEL_ENTRY_H */
--- a/arch/mips/include/asm/mach-generic/spaces.h
+++ b/arch/mips/include/asm/mach-generic/spaces.h
@@ -22,15 +22,16 @@
  * This gives the physical RAM offset.
  */
 #ifndef __ASSEMBLER__
-# if defined(CONFIG_MIPS_AUTO_PFN_OFFSET)
-#  define PHYS_OFFSET		((unsigned long)PFN_PHYS(ARCH_PFN_OFFSET))
-# elif !defined(PHYS_OFFSET)
-#  define PHYS_OFFSET		_AC(0, UL)
-# endif
+# define PHYS_OFFSET		_AC(0x20000000, UL)
 #endif /* __ASSEMBLER__ */
 
 #ifdef CONFIG_32BIT
+#ifdef CONFIG_EVA
+#define CAC_BASE		_AC(0x60000000, UL)
+#define FIXADDR_TOP		((unsigned long)(long)(int)0xdffe0000)
+#else
 #define CAC_BASE		_AC(0x80000000, UL)
+#endif
 #ifndef IO_BASE
 #define IO_BASE			_AC(0xa0000000, UL)
 #endif
@@ -46,7 +47,7 @@
  * Memory above this physical address will be considered highmem.
  */
 #ifndef HIGHMEM_START
-#define HIGHMEM_START		_AC(0x20000000, UL)
+#define HIGHMEM_START		_AC(0xffff0000, UL)
 #endif
 
 #define CKSEG0ADDR_OR_64BIT(x)	CKSEG0ADDR(x)
@@ -92,7 +93,7 @@
  * This handles the memory map.
  */
 #ifndef PAGE_OFFSET
-#define PAGE_OFFSET		(CAC_BASE + PHYS_OFFSET)
+#define PAGE_OFFSET		CAC_BASE
 #endif
 
 #ifndef FIXADDR_TOP
--- a/arch/mips/include/asm/page.h
+++ b/arch/mips/include/asm/page.h
@@ -160,15 +160,6 @@
 		return x < CKSEG0 ? XPHYSADDR(x) : CPHYSADDR(x);
 	}
 
-	if (!IS_ENABLED(CONFIG_EVA)) {
-		/*
-		 * We're using the standard MIPS32 legacy memory map, ie.
-		 * the address x is going to be in kseg0 or kseg1. We can
-		 * handle either case by masking out the desired bits using
-		 * CPHYSADDR.
-		 */
-		return CPHYSADDR(x);
-	}
 
 	/*
 	 * EVA is in use so the memory map could be anything, making it not
