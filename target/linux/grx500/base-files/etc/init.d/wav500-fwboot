#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=19

start() {
	for dev in /sys/bus/pci/drivers/wav500/*; do
		[ -w "$dev/fw_boot" ] || continue
		case "$(basename "$dev")" in
		0000:*)
			[ -f /lib/firmware/wav500/ap_upper_gen5b_wrx_514.bin ] || continue
			;;
		0001:*)
			[ -f /lib/firmware/wav500/ap_upper_gen5b_wrx_500.bin ] || continue
			;;
		*)
			[ -f /lib/firmware/wav500/ap_upper_gen5b_wrx_500.bin ] || \
			[ -f /lib/firmware/wav500/ap_upper_gen5b_wrx_514.bin ] || continue
			;;
		esac
		echo 1 > "$dev/fw_boot"
	done
}

boot() {
	start
}
